{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:optical-format-import:prescription:1.0",
  "title": "Normalized optical prescription (declarations, not computed optics)",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "source": {
      "type": "object",
      "properties": {
        "format": {
          "enum": [
            "zemax",
            "oslo"
          ]
        },
        "filename": {
          "type": "string"
        },
        "encoding": {
          "type": "string"
        },
        "upstreamRevision": {
          "type": "string"
        }
      },
      "required": [
        "format",
        "filename",
        "encoding",
        "upstreamRevision"
      ],
      "additionalProperties": false
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "const": "sequential"
    },
    "units": {
      "type": "object",
      "properties": {
        "length": {
          "const": "mm"
        },
        "wavelength": {
          "const": "um"
        },
        "angle": {
          "const": "deg"
        },
        "sourceLength": {
          "type": "string"
        },
        "scaleToMm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "length",
        "wavelength",
        "angle",
        "sourceLength",
        "scaleToMm"
      ],
      "additionalProperties": false
    },
    "aperture": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      },
      "required": [
        "kind",
        "value",
        "source"
      ],
      "additionalProperties": false
    },
    "fields": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "weight": {
                "type": "number",
                "minimum": 0
              },
              "vignetting": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/jsonValue"
                }
              }
            },
            "required": [
              "x",
              "y",
              "weight",
              "vignetting"
            ],
            "additionalProperties": false
          }
        },
        "reference": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "y": {
                  "type": "number"
                },
                "coordinates": {
                  "const": "prescriptionExtent"
                }
              },
              "required": [
                "y",
                "coordinates"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      },
      "required": [
        "kind",
        "points",
        "reference",
        "source"
      ],
      "additionalProperties": false
    },
    "wavelengths": {
      "type": "object",
      "properties": {
        "valuesUm": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "weights": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "primaryIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "valuesUm",
        "weights",
        "primaryIndex"
      ],
      "additionalProperties": false
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "surface": {
            "type": "integer",
            "minimum": -1
          }
        },
        "required": [
          "severity",
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "raw": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "name",
    "mode",
    "units",
    "aperture",
    "fields",
    "wavelengths",
    "surfaces",
    "diagnostics",
    "raw"
  ],
  "additionalProperties": false,
  "$defs": {
    "jsonValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "opticalNumber": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "special": {
              "enum": [
                "positiveInfinity",
                "negativeInfinity"
              ]
            }
          },
          "required": [
            "special"
          ],
          "additionalProperties": false
        }
      ]
    },
    "surface": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "object",
            "surface",
            "image",
            "coordinateBreak"
          ]
        },
        "type": {
          "type": "string"
        },
        "radiusMm": {
          "$ref": "#/$defs/opticalNumber"
        },
        "thicknessMm": {
          "$ref": "#/$defs/opticalNumber"
        },
        "conic": {
          "type": "number"
        },
        "stop": {
          "type": "boolean"
        },
        "material": {
          "$ref": "#/$defs/material"
        },
        "clearAperture": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/jsonValue"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      },
      "required": [
        "index",
        "role",
        "type",
        "radiusMm",
        "thicknessMm",
        "conic",
        "stop",
        "material",
        "clearAperture",
        "parameters"
      ],
      "additionalProperties": false
    },
    "material": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "air"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "mirror"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "catalog"
            },
            "name": {
              "type": "string"
            },
            "resolution": {
              "const": "unresolved"
            },
            "catalogs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nd": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "vd": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "name",
            "resolution"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "model"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "nd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "vd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dispersion": {
              "const": "unspecified"
            },
            "resolution": {
              "const": "unresolved"
            }
          },
          "required": [
            "kind",
            "name",
            "nd",
            "vd",
            "dispersion",
            "resolution"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "constantIndex"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "index": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "name",
            "index"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "sampledIndex"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "wavelengthsUm": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "indices": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "required": [
            "kind",
            "name",
            "wavelengthsUm",
            "indices"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "raw": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "raw"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
