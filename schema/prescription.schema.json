{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:optical-format-import:prescription:2.0",
  "title": "Normalized optical prescription (declarations, not computed optics)",
  "description": "The JSON written by stringify(). Lengths are millimeters and wavelengths micrometers; parameters, source and raw keep file units. Infinite numbers appear as { \"special\": \"positiveInfinity\" | \"negativeInfinity\" }.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "source": {
      "type": "object",
      "properties": {
        "format": {
          "enum": ["zemax", "oslo"]
        },
        "encoding": {
          "enum": ["text", "utf-8", "utf-16-le", "utf-16-be", "iso-8859-1", "cp1252"]
        },
        "upstreamRevision": {
          "type": "string"
        }
      },
      "required": ["format", "encoding", "upstreamRevision"],
      "additionalProperties": false
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "const": "sequential"
    },
    "units": {
      "type": "object",
      "properties": {
        "length": {
          "const": "mm"
        },
        "wavelength": {
          "const": "um"
        },
        "angle": {
          "const": "deg"
        },
        "sourceLength": {
          "enum": ["MM", "CM", "M", "IN", "INCH", "lensUnit"]
        },
        "scaleToMm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": ["length", "wavelength", "angle", "sourceLength", "scaleToMm"],
      "additionalProperties": false
    },
    "aperture": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "entrancePupilDiameter",
                "beamRadiusAtSurface1",
                "imageFNumber",
                "paraxialImageFNumber",
                "objectNA",
                "imageNA",
                "objectConeAngle",
                "imageSlope"
              ]
            },
            "value": {
              "type": "number",
              "minimum": 0
            },
            "source": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/jsonValue"
              }
            }
          },
          "required": ["kind", "value", "source"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": ["floatingStop", "unspecified"]
            },
            "value": {
              "type": "null"
            },
            "source": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/jsonValue"
              }
            }
          },
          "required": ["kind", "value", "source"],
          "additionalProperties": false
        }
      ]
    },
    "fields": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "angle",
            "theodoliteAngle",
            "objectHeight",
            "paraxialImageHeight",
            "realImageHeight",
            "gaussianImageHeight",
            "unknown"
          ]
        },
        "specification": {
          "enum": ["pointList", "fullField"]
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "weight": {
                "type": "number",
                "minimum": 0
              },
              "vignetting": {
                "type": "object",
                "properties": {
                  "decenterX": {
                    "type": "number"
                  },
                  "decenterY": {
                    "type": "number"
                  },
                  "compressX": {
                    "type": "number"
                  },
                  "compressY": {
                    "type": "number"
                  },
                  "tangentAngle": {
                    "type": "number"
                  }
                },
                "required": ["decenterX", "decenterY", "compressX", "compressY", "tangentAngle"],
                "additionalProperties": false
              }
            },
            "required": ["x", "y", "weight", "vignetting"],
            "additionalProperties": false
          }
        },
        "relativePoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "weight": {
                "type": "number",
                "minimum": 0
              },
              "vignetteX": {
                "type": "number"
              },
              "vignetteY": {
                "type": "number"
              }
            },
            "required": ["index", "x", "y", "weight", "vignetteX", "vignetteY"],
            "additionalProperties": false
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      },
      "required": ["kind", "specification", "points", "relativePoints", "source"],
      "additionalProperties": false
    },
    "wavelengths": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "weights": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "primaryIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["values", "weights", "primaryIndex"],
      "additionalProperties": false
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": ["info", "warning"]
          },
          "code": {
            "enum": [
              "uninterpreted_record",
              "assumed_units",
              "multiple_apertures",
              "field_count_mismatch",
              "relative_field_table",
              "missing_primary_wavelength",
              "legacy_wavl",
              "unresolved_surface_type",
              "unresolved_material",
              "unresolved_coordinates",
              "unresolved_constraints",
              "unresolved_optical_feature",
              "image_focus_declaration",
              "configuration_declarations"
            ]
          },
          "message": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "surface": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["severity", "code", "message"],
        "additionalProperties": false
      }
    },
    "raw": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "name",
    "mode",
    "units",
    "aperture",
    "fields",
    "wavelengths",
    "surfaces",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$defs": {
    "jsonValue": {
      "anyOf": [
        {
          "type": ["string", "number", "boolean", "null"]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "opticalNumber": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "special": {
              "enum": ["positiveInfinity", "negativeInfinity"]
            }
          },
          "required": ["special"],
          "additionalProperties": false
        }
      ]
    },
    "surface": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": ["object", "surface", "image", "coordinateBreak"]
        },
        "type": {
          "enum": [
            "standard",
            "evenAsphere",
            "oddAsphere",
            "toroidal",
            "coordinateBreak",
            "paraxial",
            "polynomial",
            "unknown"
          ]
        },
        "nativeType": {
          "type": "string"
        },
        "radius": {
          "$ref": "#/$defs/opticalNumber"
        },
        "thickness": {
          "$ref": "#/$defs/opticalNumber"
        },
        "conic": {
          "type": "number"
        },
        "stop": {
          "type": "boolean"
        },
        "material": {
          "$ref": "#/$defs/material"
        },
        "clearAperture": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "annulus"
                },
                "minRadius": {
                  "type": "number",
                  "minimum": 0
                },
                "maxRadius": {
                  "type": "number",
                  "minimum": 0
                },
                "offsetX": {
                  "type": "number"
                },
                "offsetY": {
                  "type": "number"
                },
                "checked": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "checkingEnabled": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["kind", "minRadius", "maxRadius", "offsetX", "offsetY", "checked", "checkingEnabled"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "semiDiameter": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "asphereTerms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "power": {
                "type": "integer",
                "minimum": 0
              },
              "coefficient": {
                "type": "number"
              },
              "native": {
                "type": "string"
              }
            },
            "required": ["power", "coefficient", "native"],
            "additionalProperties": false
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      },
      "required": [
        "index",
        "role",
        "type",
        "nativeType",
        "radius",
        "thickness",
        "conic",
        "stop",
        "material",
        "clearAperture",
        "semiDiameter",
        "parameters"
      ],
      "additionalProperties": false,
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "enum": ["evenAsphere", "oddAsphere"]
          }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "asphereTerms": true
        },
        "required": ["asphereTerms"]
      },
      "else": {
        "type": "object",
        "properties": {
          "asphereTerms": false
        }
      }
    },
    "material": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "air"
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "mirror"
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "catalog"
            },
            "name": {
              "type": "string"
            },
            "catalogs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nd": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "vd": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "resolution": {
              "const": "unresolved"
            }
          },
          "required": ["kind", "name", "catalogs", "nd", "vd", "resolution"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "model"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "nd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "vd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dispersion": {
              "const": "unspecified"
            },
            "resolution": {
              "const": "unresolved"
            }
          },
          "required": ["kind", "name", "nd", "vd", "dispersion", "resolution"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "constantIndex"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "index": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": ["kind", "name", "index"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "sampledIndex"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "wavelengths": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "indices": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "required": ["kind", "name", "wavelengths", "indices"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "raw": {
              "type": "string"
            }
          },
          "required": ["kind", "raw"],
          "additionalProperties": false
        }
      ]
    }
  }
}
