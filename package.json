{
  "name": "optical-format-parser",
  "version": "1.0.3",
  "description": "Browser-native Zemax and OSLO prescription parsers and normalized JSON",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": "./schema/prescription.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "schema",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json",
    "check:dist": "npm run build && test -z \"$(git status --porcelain -- dist)\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test test/*.test.ts",
    "test:package": "npm run build && node --test test/package.test.mjs",
    "test:all": "npm run format:check && npm run check && npm test && npm run test:package",
    "demo": "npm run build && node scripts/serve.mjs",
    "prepack": "npm run build",
    "release": "npm run test:all && npm run check:dist && bumpp package.json package-lock.json README.md"
  },
  "keywords": [
    "zemax",
    "oslo",
    "optics",
    "parser",
    "typescript",
    "browser"
  ],
  "devDependencies": {
    "@types/node": "^26.0.0",
    "ajv": "^8.17.1",
    "bumpp": "^12.3.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
